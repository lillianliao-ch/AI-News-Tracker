        transform: none;
      }

      .result-container {
        margin-top: 20px;
        padding: 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
        border-radius: 12px;
        border-left: 4px solid #667eea;
      }

      .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
      }

      .result-header h4 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        color: #667eea;
      }

      .copy-all-btn {
        padding: 6px 16px;
        background: white;
        border: 2px solid #667eea;
        color: #667eea;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s;
      }

      .copy-all-btn:hover {
        background: #667eea;
        color: white;
      }

      .copy-all-btn.copied {
        background: #28a745;
        border-color: #28a745;
        color: white;
      }

      .result-content {
        line-height: 1.8;
      }

      .result-content .loading {
        text-align: center;
        color: #999;
      }

      .version-section {
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 2px dashed #ddd;
      }

      .version-section:last-child {
        border-bottom: none;
      }

      .version-title {
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 12px 0;
        color: #333;
      }

      .version-tag {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        margin-left: 8px;
      }

      .tag-a {
        background: #e3f2fd;
        color: #1976d2;
      }

      .tag-b {
        background: #fce4ec;
        color: #c2185b;
      }

      .tag-c {
        background: #e8f5e9;
        color: #388e3c;
      }

      .generated-content {
        background: white;
        padding: 16px;
        border-radius: 8px;
        margin-top: 12px;
        white-space: pre-wrap;
        color: #333;
        line-height: 1.8;
      }

      .generated-hashtags {
        color: #667eea;
        font-weight: 500;
        margin-top: 12px;
      }
    </style>

    <script define:vars={{ selectedNewsId }}>
      // 简单的编码函数用于 localStorage 键
      function encodeNewsId(newsId) {
        try {
          return btoa(encodeURIComponent(newsId));
        } catch (e) {
          return newsId.replace(/[^a-zA-Z0-9]/g, '_');
        }
      }

      function decodeNewsId(encoded) {
        try {
          return decodeURIComponent(atob(encoded));
        } catch (e) {
          return encoded;
        }
      }

      // 页面加载后，如果有选中的新闻，滚动到该位置
      if (selectedNewsId) {
        // 解码 news_id
        const decodedNewsId = decodeURIComponent(selectedNewsId);
        const encodedNewsId = encodeNewsId(decodedNewsId);

        window.addEventListener('DOMContentLoaded', () => {
          const selectedElement = document.getElementById(`news-${decodedNewsId}`);
          if (selectedElement) {
            setTimeout(() => {
              selectedElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 100);
          }

          // 检查是否有已保存的生成结果
          try {
            const savedResults = JSON.parse(localStorage.getItem('generated_results') || '{}');
            const now = Date.now();

            if (savedResults[encodedNewsId]) {
              const data = savedResults[encodedNewsId];
              // 如果结果超过1天，清理掉
              if (now - data.timestamp > 24 * 60 * 60 * 1000) {
                delete savedResults[encodedNewsId];
                localStorage.setItem('generated_results', JSON.stringify(savedResults));
                return;
              }

              // 显示已保存的结果
              const resultContainer = document.getElementById(`result-${decodedNewsId}`);
              const resultContent = document.getElementById(`result-content-${decodedNewsId}`);
              const generateBtn = document.querySelector(`[data-news-id="${decodedNewsId}"].generate-all-btn`);

              if (resultContainer && resultContent) {
                resultContainer.style.display = 'block';
                // 调用 displayResults 函数
                window._displaySavedResults = window._displaySavedResults || [];
                window._displaySavedResults.push({ results: data.results, newsId: decodedNewsId });
              }

              if (generateBtn) {
                generateBtn.textContent = '🚀 重新生成';
              }
            }
          } catch (e) {
            console.error('Error loading saved results:', e);
          }
        });
      }
    </script>

    <script>
      // 存储所有轮询定时器
      const pollIntervals = new Map();

      // 简单的编码函数用于 localStorage 键
      function encodeNewsId(newsId) {
        return btoa(encodeURIComponent(newsId));
      }

      function decodeNewsId(encoded) {
        return decodeURIComponent(atob(encoded));
      }

      // 生成内容函数
      async function generateAllVersions(newsId) {
        const resultContainer = document.getElementById(`result-${newsId}`);
        const resultContent = document.getElementById(`result-content-${newsId}`);
        const generateBtn = document.querySelector(`[data-news-id="${newsId}"].generate-all-btn`);

        if (resultContainer) {
          resultContainer.style.display = 'block';
        }

        if (resultContent) {
          resultContent.innerHTML = '<p class="loading">⏳ 生成任务已启动，AI 正在后台生成中...<br><span style="font-size: 12px; color: #999;">您可以离开此页面，稍后回来查看结果</span></p>';
        }

        if (generateBtn) {
          generateBtn.disabled = true;
          generateBtn.textContent = '✅ 已启动生成';
        }

        try {
          // 启动异步生成任务
          const response = await fetch('http://localhost:8000/api/generate', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              news_id: newsId,
              versions: ['A', 'B', 'C']
            })
          });

          if (response.ok) {
            const data = await response.json();
            const taskId = data.task_id;

            // 开始轮询任务状态
            pollTaskStatus(taskId, newsId);
          } else {
            const error = await response.json();
            if (resultContent) {
              resultContent.innerHTML = `<p class="loading" style="color: #dc3545;">❌ 生成失败：${error.detail || error.message || '未知错误'}</p>`;
            }
            if (generateBtn) {
              generateBtn.disabled = false;
              generateBtn.textContent = '🚀 一键生成全部版本';
            }
          }
        } catch (error) {
          console.error('生成错误:', error);
          if (resultContent) {
            resultContent.innerHTML = `<p class="loading" style="color: #dc3545;">❌ 生成失败：${error.message}</p>`;
          }
          if (generateBtn) {
            generateBtn.disabled = false;
            generateBtn.textContent = '🚀 一键生成全部版本';
          }
        }
      }

      // 轮询任务状态
      function pollTaskStatus(taskId, newsId) {
        // 保存任务状态到 localStorage
        try {
          const encodedNewsId = encodeNewsId(newsId);
          const pendingTasks = JSON.parse(localStorage.getItem('pending_generation_tasks') || '{}');
          pendingTasks[encodedNewsId] = {
            taskId: taskId,
            newsId: newsId,
            startTime: Date.now()
          };
          localStorage.setItem('pending_generation_tasks', JSON.stringify(pendingTasks));
        } catch (e) {
          console.error('localStorage error:', e);
        }

        let isPolling = true;
        let pollCount = 0;
        const MAX_POLLS = 150; // 最多轮询150次（5分钟）

        const poll = async () => {
          // 如果页面不可见，跳过这次轮询
          if (document.hidden) {
            return;
          }

          if (!isPolling || pollCount >= MAX_POLLS) {
            stopPolling();
            if (pollCount >= MAX_POLLS) {
              // 超时处理
              const resultContent = document.getElementById(`result-content-${newsId}`);
              if (resultContent) {
                resultContent.innerHTML = '<p class="loading" style="color: #999;">⏳ 生成时间较长，请稍后手动刷新页面查看结果</p>';
              }
            }
            return;
          }

          pollCount++;

          try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 10000); // 10秒超时

            const response = await fetch(`http://localhost:8000/api/generate/status/${taskId}`, {
              signal: controller.signal
            });
            clearTimeout(timeoutId);

            if (!response.ok) {
              stopPolling();
              cleanupPendingTask(newsId);
              return;
            }

            const data = await response.json();

            if (data.status === 'completed') {
              stopPolling();
              // 保存结果到 localStorage
              try {
                const encodedNewsId = encodeNewsId(newsId);
                const savedResults = JSON.parse(localStorage.getItem('generated_results') || '{}');
                savedResults[encodedNewsId] = {
                  newsId: newsId,
                  results: data.results,
                  timestamp: Date.now()
                };
                localStorage.setItem('generated_results', JSON.stringify(savedResults));
              } catch (e) {
                console.error('Failed to save results:', e);
              }
              displayResults(data.results, newsId);
              cleanupPendingTask(newsId);
            } else if (data.status === 'failed') {
              stopPolling();
              const resultContent = document.getElementById(`result-content-${newsId}`);
              const generateBtn = document.querySelector(`[data-news-id="${newsId}"].generate-all-btn`);
              if (resultContent) {
                resultContent.innerHTML = `<p class="loading" style="color: #dc3545;">❌ 生成失败：${data.error || '未知错误'}</p>`;
              }
              if (generateBtn) {
                generateBtn.disabled = false;
                generateBtn.textContent = '🚀 一键生成全部版本';
              }
              cleanupPendingTask(newsId);
            }
          } catch (error) {
            console.error('查询任务状态失败:', error);
            // 不停止轮询，继续尝试
          }
        };

        const stopPolling = () => {
          isPolling = false;
          const encodedNewsId = encodeNewsId(newsId);
          const interval = pollIntervals.get(encodedNewsId);
          if (interval) {
            clearInterval(interval);
            pollIntervals.delete(encodedNewsId);
          }
        };

        // 每2秒轮询一次
        const interval = setInterval(poll, 2000);
        pollIntervals.set(encodeNewsId(newsId), interval);
      }

      // 显示生成结果
      function displayResults(results, newsId) {
        console.log('displayResults called with newsId:', newsId, 'results:', results);
        const resultContent = document.getElementById(`result-content-${newsId}`);
        const generateBtn = document.querySelector(`[data-news-id="${newsId}"].generate-all-btn`);

        console.log('resultContent:', resultContent, 'generateBtn:', generateBtn);

        if (resultContent) {
          let html = '';
          results.forEach(result => {
            const versionInfo = {
              'A': { name: '硬核技术风', class: 'tag-a' },
              'B': { name: '轻松科普风', class: 'tag-b' },
              'C': { name: '热点观点风', class: 'tag-c' }
            };
            const info = versionInfo[result.version] || { name: '未知', class: '' };

            if (result.error) {
              html += `
                <div class="version-section">
                  <h3 class="version-title">
                    版本 ${result.version}
                    <span class="version-tag tag-error">生成失败</span>
                  </h3>
                  <div class="generated-content" style="color: #dc3545;">${result.error}</div>
                </div>
              `;
            } else {
              html += `
                <div class="version-section">
                  <h3 class="version-title">
                    版本 ${result.version}
                    <span class="version-tag ${info.class}">${info.name}</span>
                  </h3>
                  <div class="generated-content">${result.content}</div>
                  <div class="generated-hashtags">${result.hashtags ? result.hashtags.join(' ') : ''}</div>
                </div>
              `;
            }
          });
          resultContent.innerHTML = html;
          console.log('Results displayed');
        }

        if (generateBtn) {
          generateBtn.disabled = false;
          generateBtn.textContent = '🚀 重新生成';
        }
      }

      // 复制全部内容
      function copyAllContent(targetId) {
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          const text = targetElement.innerText || targetElement.textContent;

          navigator.clipboard.writeText(text).then(() => {
            const copyBtn = document.querySelector(`[data-target="${targetId}"].copy-all-btn`);
            if (copyBtn) {
              const originalText = copyBtn.textContent;
              copyBtn.textContent = '✅ 已复制';
              copyBtn.classList.add('copied');

              setTimeout(() => {
                copyBtn.textContent = originalText;
                copyBtn.classList.remove('copied');
              }, 2000);
            }
          }).catch(err => {
            console.error('复制失败:', err);
            alert('复制失败，请手动选择文本复制');
          });
        }
      }

      // 清理所有轮询
      function cleanupAllPolling() {
        pollIntervals.forEach((interval, key) => {
          clearInterval(interval);
        });
        pollIntervals.clear();
      }

      // 页面可见性变化时处理
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          console.log('页面隐藏，暂停轮询');
        } else {
          console.log('页面可见，恢复轮询');
        }
      });

      // 页面卸载前清理所有轮询
      window.addEventListener('beforeunload', () => {
        cleanupAllPolling();
      });

      // 为所有生成按钮添加事件
      document.addEventListener('DOMContentLoaded', () => {
        // 处理保存的结果（从 define:vars 脚本传递过来的）
        if (window._displaySavedResults && window._displaySavedResults.length > 0) {
          window._displaySavedResults.forEach(({ results, newsId }) => {
            displayResults(results, newsId);
          });
          window._displaySavedResults = [];
        }

        // 检查是否有正在进行的任务
        checkPendingTasks();

        const generateButtons = document.querySelectorAll('.generate-all-btn');
        generateButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const newsId = btn.dataset.newsId;
            generateAllVersions(newsId);
          });
        });

        // 为复制按钮添加事件
        const copyButtons = document.querySelectorAll('.copy-all-btn');
        copyButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const targetId = btn.dataset.target;
            copyAllContent(targetId);
          });
        });
      });

      // 检查是否有正在进行的任务或已完成的生成结果
      function checkPendingTasks() {
        // 首先检查是否有已完成的生成结果
        try {
          const savedResults = JSON.parse(localStorage.getItem('generated_results') || '{}');
          const now = Date.now();

          Object.entries(savedResults).forEach(([encodedNewsId, data]) => {
            const newsId = data.newsId || decodeNewsId(encodedNewsId);
            // 如果结果超过1天，清理掉
            if (now - data.timestamp > 24 * 60 * 60 * 1000) {
              delete savedResults[encodedNewsId];
              localStorage.setItem('generated_results', JSON.stringify(savedResults));
              return;
            }

            // 显示已保存的结果
            const resultContainer = document.getElementById(`result-${newsId}`);
            const resultContent = document.getElementById(`result-content-${newsId}`);
            const generateBtn = document.querySelector(`[data-news-id="${newsId}"].generate-all-btn`);

            if (resultContainer && resultContent) {
              resultContainer.style.display = 'block';
              displayResults(data.results, newsId);
            }

            if (generateBtn) {
              generateBtn.textContent = '🚀 重新生成';
            }
          });
        } catch (e) {
          console.error('Error loading saved results:', e);
        }

        // 然后检查是否有正在进行的任务
        try {
          const pendingTasks = JSON.parse(localStorage.getItem('pending_generation_tasks') || '{}');

          Object.entries(pendingTasks).forEach(([encodedNewsId, taskData]) => {
            const newsId = taskData.newsId || decodeNewsId(encodedNewsId);
            const { taskId, startTime } = taskData;

            // 如果任务超过30分钟，认为已过期
            if (Date.now() - startTime > 30 * 60 * 1000) {
              delete pendingTasks[encodedNewsId];
              localStorage.setItem('pending_generation_tasks', JSON.stringify(pendingTasks));
              return;
            }

            // 检查是否已经有结果了
            try {
              const savedResults = JSON.parse(localStorage.getItem('generated_results') || '{}');
              if (savedResults[encodedNewsId]) {
                // 已有结果，清理pending任务
                delete pendingTasks[encodedNewsId];
                localStorage.setItem('pending_generation_tasks', JSON.stringify(pendingTasks));
                return;
              }
            } catch (e) {
              // 忽略错误
            }

            // 显示加载状态
            const resultContainer = document.getElementById(`result-${newsId}`);
            const resultContent = document.getElementById(`result-content-${newsId}`);
            const generateBtn = document.querySelector(`[data-news-id="${newsId}"].generate-all-btn`);

            if (resultContainer) {
              resultContainer.style.display = 'block';
            }

            if (resultContent) {
              resultContent.innerHTML = '<p class="loading">⏳ 检测到之前的生成任务，正在恢复...<br><span style="font-size: 12px; color: #999;">AI 正在后台生成中</span></p>';
            }

            if (generateBtn) {
              generateBtn.disabled = true;
              generateBtn.textContent = '✅ 生成中';
            }

            // 继续轮询任务状态
            pollTaskStatusWithCleanup(taskId, newsId);
          });
        } catch (e) {
          console.error('Error checking pending tasks:', e);
        }
      }

      // 带清理的轮询任务状态
      function pollTaskStatusWithCleanup(taskId, newsId) {
        let isPolling = true;
        const encodedNewsId = encodeNewsId(newsId);
        const restoreKey = `restore_${encodedNewsId}`;

        const poll = async () => {
          // 如果页面不可见，跳过这次轮询
          if (document.hidden) {
            return;
          }

          if (!isPolling) {
            return;
          }

          try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 10000);

            const response = await fetch(`http://localhost:8000/api/generate/status/${taskId}`, {
              signal: controller.signal
            });
            clearTimeout(timeoutId);

            if (!response.ok) {
              stopPollingWithCleanup();
              cleanupPendingTask(newsId);
              return;
            }

            const data = await response.json();

            if (data.status === 'completed') {
              stopPollingWithCleanup();
              // 保存结果到 localStorage
              try {
                const savedResults = JSON.parse(localStorage.getItem('generated_results') || '{}');
                savedResults[encodedNewsId] = {
                  newsId: newsId,
                  results: data.results,
                  timestamp: Date.now()
                };
                localStorage.setItem('generated_results', JSON.stringify(savedResults));
              } catch (e) {
                console.error('Failed to save results:', e);
              }
              displayResults(data.results, newsId);
              cleanupPendingTask(newsId);
            } else if (data.status === 'failed') {
              stopPollingWithCleanup();
              const resultContent = document.getElementById(`result-content-${newsId}`);
              const generateBtn = document.querySelector(`[data-news-id="${newsId}"].generate-all-btn`);
              if (resultContent) {
                resultContent.innerHTML = `<p class="loading" style="color: #dc3545;">❌ 生成失败：${data.error || '未知错误'}</p>`;
              }
              if (generateBtn) {
                generateBtn.disabled = false;
                generateBtn.textContent = '🚀 一键生成全部版本';
              }
              cleanupPendingTask(newsId);
            }
          } catch (error) {
            console.error('查询任务状态失败:', error);
            // 不停止轮询，继续尝试
          }
        };

        const stopPollingWithCleanup = () => {
          isPolling = false;
          const interval = pollIntervals.get(restoreKey);
          if (interval) {
            clearInterval(interval);
            pollIntervals.delete(restoreKey);
          }
        };

        const interval = setInterval(poll, 2000);
        pollIntervals.set(restoreKey, interval);
      }

      // 清理待处理的任务
      function cleanupPendingTask(newsId) {
        try {
          const encodedNewsId = encodeNewsId(newsId);
          const pendingTasks = JSON.parse(localStorage.getItem('pending_generation_tasks') || '{}');
          delete pendingTasks[encodedNewsId];
          localStorage.setItem('pending_generation_tasks', JSON.stringify(pendingTasks));
        } catch (e) {
          console.error('Failed to cleanup pending task:', e);
        }
      }
    </script>
  </body>
</html>
