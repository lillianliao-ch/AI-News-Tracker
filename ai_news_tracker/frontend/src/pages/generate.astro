      .actions {
        display: flex;
        gap: 12px;
      }

      .generate-all-btn {
        padding: 12px 24px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 8px;
