    "linkedin": null,
    "homepage_text": "ÿþ<\u0000p\u0000>\u0000&\u0000n\u0000b\u0000s\u0000p\u0000;\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000!\u0000-\u0000-\u0000 \u0000B\u0000E\u0000G\u0000I\u0000N\u0000 \u0000H\u0000E\u0000A\u0000D\u0000 \u0000-\u0000-\u0000>\u0000\n\u0000<\u0000t\u0000a\u0000b\u0000l\u0000e\u0000 \u0000b\u0000o\u0000r\u0000d\u0000e\u0000r\u0000=\u0000\"\u00000\u0000\"\u0000 \u0000w\u0000i\u0000d\u0000t\u0000h\u0000=\u0000\"\u00006\u00006\u0000.\u00008\u0000%\u0000\"\u0000 \u0000c\u0000e\u0000l\u0000l\u0000s\u0000p\u0000a\u0000c\u0000i\u0000n\u0000g\u0000=\u0000\"\u00000\u0000\"\u0000 \u0000c\u0000e\u0000l\u0000l\u0000p\u0000a\u0000d\u0000d\u0000i\u0000n\u0000g\u0000=\u0000\"\u00003\u0000\"\u0000 \u0000a\u0000l\u0000i\u0000g\u0000n\u0000=\u0000\"\u0000c\u0000e\u0000n\u0000t\u0000e\u0000r\u0000\"\u0000>\u0000\n\u0000<\u0000t\u0000b\u0000o\u0000d\u0000y\u0000>\u0000\n\u0000<\u0000t\u0000r\u0000>\u0000\n\u0000<\u0000t\u0000d\u0000>\u0000\n\u0000<\u0000d\u0000i\u0000v\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000i\u0000m\u0000a\u0000g\u0000e\u0000 \u0000i\u0000m\u0000a\u0000g\u0000e\u0000-\u0000r\u0000i\u0000g\u0000h\u0000t\u0000\"\u0000>\u0000&\u0000n\u0000b\u0000s\u0000p\u0000;\u0000<\u0000/\u0000d\u0000i\u0000v\u0000>\u0000\n\u0000<\u0000t\u0000a\u0000b\u0000l\u0000e\u0000>\u0000\n\u0000<\u0000t\u0000b\u0000o\u0000d\u0000y\u0000>\u0000\n\u0000<\u0000t\u0000r\u0000>\u0000\n\u0000<\u0000t\u0000d\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u0000t\u0000y\u0000l\u0000e\u00001\u0000\"\u0000>\u0000\n\u0000<\u0000h\u00002\u0000>\u0000F\u0000e\u0000n\u0000g\u0000 \u0000C\u0000h\u0000e\u0000n\u0000<\u0000/\u0000h\u00002\u0000>\u0000\n\u0000<\u0000p\u0000>\u0000A\u0000s\u0000s\u0000o\u0000c\u0000i\u0000a\u0000t\u0000e\u0000 \u0000P\u0000r\u0000o\u0000f\u0000e\u0000s\u0000s\u0000o\u0000r\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000a\u0000>\u0000D\u0000i\u0000r\u0000e\u0000c\u0000t\u0000o\u0000r\u0000,\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000s\u0000:\u0000/\u0000/\u0000p\u0000e\u0000r\u0000s\u0000o\u0000n\u0000a\u0000l\u0000.\u0000u\u0000t\u0000d\u0000a\u0000l\u0000l\u0000a\u0000s\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000f\u0000x\u0000c\u00001\u00009\u00000\u00000\u00000\u00007\u0000/\u0000p\u0000d\u0000m\u0000l\u0000/\u0000\"\u0000>\u0000A\u0000I\u0000 \u0000S\u0000a\u0000f\u0000e\u0000t\u0000y\u0000 \u0000L\u0000a\u0000b\u0000o\u0000r\u0000a\u0000t\u0000o\u0000r\u0000y\u0000<\u0000/\u0000a\u0000>\u0000<\u0000a\u0000/\u0000>\u0000<\u0000B\u0000R\u0000>\u0000\n\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000c\u0000s\u0000.\u0000u\u0000t\u0000d\u0000a\u0000l\u0000l\u0000a\u0000s\u0000.\u0000e\u0000d\u0000u\u0000/\u0000\"\u0000>\u0000D\u0000e\u0000p\u0000a\u0000r\u0000t\u0000m\u0000e\u0000n\u0000t\u0000 \u0000o\u0000f\u0000 \u0000C\u0000o\u0000m\u0000p\u0000u\u0000t\u0000e\u0000r\u0000 \u0000S\u0000c\u0000i\u0000e\u0000n\u0000c\u0000e\u0000<\u0000/\u0000a\u0000>\u0000<\u0000B\u0000R\u0000>\u0000\n\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000e\u0000c\u0000s\u0000.\u0000u\u0000t\u0000d\u0000a\u0000l\u0000l\u0000a\u0000s\u0000.\u0000e\u0000d\u0000u\u0000/\u0000\"\u0000>\u0000E\u0000r\u0000i\u0000k\u0000 \u0000J\u0000o\u0000n\u0000s\u0000s\u0000o\u0000n\u0000 \u0000S\u0000c\u0000h\u0000o\u0000o\u0000l\u0000 \u0000o\u0000f\u0000 \u0000E\u0000n\u0000g\u0000i\u0000n\u0000e\u0000e\u0000r\u0000i\u0000n\u0000g\u0000 \u0000&\u0000 \u0000C\u0000o\u0000m\u0000p\u0000u\u0000t\u0000e\u0000r\u0000 \u0000S\u0000c\u0000i\u0000e\u0000n\u0000c\u0000e\u0000<\u0000/\u0000a\u0000>\u0000<\u0000B\u0000R\u0000>\u0000\n\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000u\u0000t\u0000d\u0000a\u0000l\u0000l\u0000a\u0000s\u0000.\u0000e\u0000d\u0000u\u0000/\u0000\"\u0000>\u0000T\u0000h\u0000e\u0000 \u0000U\u0000n\u0000i\u0000v\u0000e\u0000r\u0000s\u0000i\u0000t\u0000y\u0000 \u0000o\u0000f\u0000 \u0000T\u0000e\u0000x\u0000a\u0000s\u0000 \u0000a\u0000t\u0000 \u0000D\u0000a\u0000l\u0000l\u0000a\u0000s\u0000<\u0000/\u0000a\u0000>\u0000 \u0000\n\u0000<\u0000p\u0000>\u0000O\u0000f\u0000f\u0000i\u0000c\u0000e\u0000:\u0000 \u0000E\u0000C\u0000S\u0000S\u0000 \u00003\u0000.\u00009\u00000\u00001\u0000 \u0000U\u0000T\u0000D\u0000 \u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000p\u0000>\u0000P\u0000h\u0000o\u0000n\u0000e\u0000:\u0000 \u00009\u00007\u00002\u0000-\u00008\u00008\u00003\u0000-\u00006\u00006\u00001\u00000\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000p\u0000>\u0000E\u0000m\u0000a\u0000i\u0000l\u0000:\u0000 \u0000f\u0000e\u0000n\u0000g\u0000.\u0000c\u0000h\u0000e\u0000n\u0000 \u0000A\u0000T\u0000 \u0000u\u0000t\u0000d\u0000a\u0000l\u0000l\u0000a\u0000s\u0000 \u0000D\u0000O\u0000T\u0000 \u0000e\u0000d\u0000u\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000/\u0000t\u0000d\u0000>\u0000\n\u0000<\u0000t\u0000d\u0000>\u0000<\u0000i\u0000m\u0000g\u0000 \u0000s\u0000r\u0000c\u0000=\u0000\"\u0000i\u0000m\u0000a\u0000g\u0000e\u0000s\u0000/\u0000F\u0000e\u0000n\u0000g\u0000_\u0000P\u0000h\u0000o\u0000t\u0000o\u00002\u0000.\u0000j\u0000p\u0000g\u0000\"\u0000 \u0000h\u0000e\u0000i\u0000g\u0000h\u0000t\u0000=\u0000\"\u00001\u00007\u00005\u0000\"\u0000 \u0000/\u0000>\u0000<\u0000/\u0000t\u0000d\u0000>\u0000\n\u0000<\u0000/\u0000t\u0000r\u0000>\u0000\n\u0000<\u0000/\u0000t\u0000b\u0000o\u0000d\u0000y\u0000>\u0000\n\u0000<\u0000/\u0000t\u0000a\u0000b\u0000l\u0000e\u0000>\u0000\n\u0000<\u0000/\u0000t\u0000d\u0000>\u0000\n\u0000<\u0000/\u0000t\u0000r\u0000>\u0000\n\u0000<\u0000t\u0000r\u0000>\u0000\n\u0000<\u0000t\u0000d\u0000>\u0000\n\u0000\n\u0000<\u0000b\u0000r\u0000/\u0000>\u0000\n\u0000\n\u0000<\u0000p\u0000>\u0000C\u0000l\u0000i\u0000c\u0000k\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000s\u0000:\u0000/\u0000/\u0000p\u0000e\u0000r\u0000s\u0000o\u0000n\u0000a\u0000l\u0000.\u0000u\u0000t\u0000d\u0000a\u0000l\u0000l\u0000a\u0000s\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000f\u0000x\u0000c\u00001\u00009\u00000\u00000\u00000\u00007\u0000/\u0000p\u0000d\u0000m\u0000l\u0000/\u0000\"\u0000>\u0000 \u0000h\u0000e\u0000r\u0000e\u0000 \u0000<\u0000/\u0000a\u0000>\u0000 \u0000t\u0000o\u0000 \u0000l\u0000e\u0000a\u0000r\u0000n\u0000 \u0000m\u0000o\u0000r\u0000e\u0000 \u0000a\u0000b\u0000o\u0000u\u0000t\u0000 \u0000o\u0000u\u0000r\u0000 \u0000n\u0000e\u0000w\u0000 \u0000A\u0000I\u0000 \u0000S\u0000a\u0000f\u0000e\u0000t\u0000y\u0000 \u0000L\u0000a\u0000b\u0000o\u0000r\u0000a\u0000t\u0000o\u0000r\u0000y\u0000!\u0000 \u0000<\u0000/\u0000p\u0000>\u0000\n\u0000\n\u0000<\u0000h\u00002\u0000>\u0000R\u0000e\u0000s\u0000e\u0000a\u0000r\u0000c\u0000h\u0000 \u0000I\u0000n\u0000t\u0000e\u0000r\u0000e\u0000s\u0000t\u0000s\u0000<\u0000/\u0000h\u00002\u0000>\u0000\n\u0000<\u0000p\u0000>\u0000\n\u0000 \u0000 \u0000O\u0000u\u0000r\u0000 \u0000r\u0000e\u0000s\u0000e\u0000a\u0000r\u0000c\u0000h\u0000 \u0000i\u0000s\u0000 \u0000d\u0000e\u0000d\u0000i\u0000c\u0000a\u0000t\u0000e\u0000d\u0000 \u0000t\u0000o\u0000 \u0000e\u0000n\u0000h\u0000a\u0000n\u0000c\u0000i\u0000n\u0000g\u0000 \u0000A\u0000I\u0000 \u0000s\u0000a\u0000f\u0000e\u0000t\u0000y\u0000 \u0000a\u0000n\u0000d\u0000 \u0000e\u0000t\u0000h\u0000i\u0000c\u0000s\u0000 \u0000b\u0000y\u0000 \u0000c\u0000r\u0000a\u0000f\u0000t\u0000i\u0000n\u0000g\u0000 \u0000r\u0000e\u0000s\u0000p\u0000o\u0000n\u0000s\u0000i\u0000b\u0000l\u0000e\u0000 \u0000m\u0000a\u0000c\u0000h\u0000i\u0000n\u0000e\u0000 \u0000l\u0000e\u0000a\u0000r\u0000n\u0000i\u0000n\u0000g\u0000 \u0000t\u0000e\u0000c\u0000h\u0000n\u0000i\u0000q\u0000u\u0000e\u0000s\u0000.\u0000 \u0000W\u0000e\u0000 \u0000a\u0000i\u0000m\u0000 \u0000t\u0000o\u0000 \u0000b\u0000u\u0000i\u0000l\u0000d\u0000 \u0000r\u0000e\u0000s\u0000i\u0000l\u0000i\u0000e\u0000n\u0000t\u0000 \u0000A\u0000I\u0000 \u0000s\u0000y\u0000s\u0000t\u0000e\u0000m\u0000s\u0000 \u0000c\u0000a\u0000p\u0000a\u0000b\u0000l\u0000e\u0000 \u0000o\u0000f\u0000 \u0000i\u0000d\u0000e\u0000n\u0000t\u0000i\u0000f\u0000y\u0000i\u0000n\u0000g\u0000 \u0000a\u0000n\u0000d\u0000 \u0000a\u0000d\u0000a\u0000p\u0000t\u0000i\u0000n\u0000g\u0000 \u0000t\u0000o\u0000 \u0000n\u0000o\u0000v\u0000e\u0000l\u0000 \u0000s\u0000c\u0000e\u0000n\u0000a\u0000r\u0000i\u0000o\u0000s\u0000,\u0000 \u0000q\u0000u\u0000a\u0000n\u0000t\u0000i\u0000f\u0000y\u0000i\u0000n\u0000g\u0000 \u0000a\u0000n\u0000d\u0000 \u0000m\u0000a\u0000n\u0000a\u0000g\u0000i\u0000n\u0000g\u0000 \u0000u\u0000n\u0000c\u0000e\u0000r\u0000t\u0000a\u0000i\u0000n\u0000t\u0000i\u0000e\u0000s\u0000 \u0000f\u0000o\u0000r\u0000 \u0000s\u0000a\u0000f\u0000e\u0000t\u0000y\u0000 \u0000a\u0000p\u0000p\u0000l\u0000i\u0000c\u0000a\u0000t\u0000i\u0000o\u0000n\u0000s\u0000,\u0000 \u0000a\u0000n\u0000d\u0000 \u0000p\u0000r\u0000o\u0000m\u0000o\u0000t\u0000i\u0000n\u0000g\u0000 \u0000f\u0000a\u0000i\u0000r\u0000n\u0000e\u0000s\u0000s\u0000 \u0000a\u0000n\u0000d\u0000 \u0000e\u0000q\u0000u\u0000i\u0000t\u0000y\u0000 \u0000i\u0000n\u0000 \u0000v\u0000a\u0000r\u0000i\u0000o\u0000u\u0000s\u0000 \u0000d\u0000o\u0000m\u0000a\u0000i\u0000n\u0000s\u0000.\u0000 \u0000O\u0000u\u0000r\u0000 \u0000o\u0000b\u0000j\u0000e\u0000c\u0000t\u0000i\u0000v\u0000e\u0000 \u0000i\u0000s\u0000 \u0000t\u0000o\u0000 \u0000r\u0000e\u0000l\u0000i\u0000a\u0000b\u0000l\u0000y\u0000 \u0000d\u0000e\u0000t\u0000e\u0000c\u0000t\u0000 \u0000a\u0000n\u0000d\u0000 \u0000a\u0000d\u0000d\u0000r\u0000e\u0000s\u0000s\u0000 \u0000s\u0000a\u0000f\u0000e\u0000t\u0000y\u0000 \u0000c\u0000o\u0000n\u0000c\u0000e\u0000r\u0000n\u0000s\u0000,\u0000 \u0000e\u0000t\u0000h\u0000i\u0000c\u0000a\u0000l\u0000 \u0000d\u0000i\u0000l\u0000e\u0000m\u0000m\u0000a\u0000s\u0000,\u0000 \u0000b\u0000i\u0000a\u0000s\u0000e\u0000s\u0000,\u0000 \u0000a\u0000n\u0000d\u0000 \u0000a\u0000n\u0000o\u0000m\u0000a\u0000l\u0000i\u0000e\u0000s\u0000 \u0000w\u0000i\u0000t\u0000h\u0000i\u0000n\u0000 \u0000c\u0000o\u0000m\u0000p\u0000l\u0000e\u0000x\u0000 \u0000d\u0000a\u0000t\u0000a\u0000s\u0000e\u0000t\u0000s\u0000.\u0000 \u0000O\u0000u\u0000r\u0000 \u0000w\u0000o\u0000r\u0000k\u0000 \u0000l\u0000e\u0000v\u0000e\u0000r\u0000a\u0000g\u0000e\u0000s\u0000 \u0000A\u0000I\u0000 \u0000t\u0000o\u0000 \u0000i\u0000m\u0000p\u0000r\u0000o\u0000v\u0000e\u0000 \u0000h\u0000e\u0000a\u0000l\u0000t\u0000h\u0000c\u0000a\u0000r\u0000e\u0000 \u0000d\u0000i\u0000a\u0000g\u0000n\u0000o\u0000s\u0000t\u0000i\u0000c\u0000s\u0000,\u0000 \u0000e\u0000n\u0000s\u0000u\u0000r\u0000e\u0000 \u0000t\u0000h\u0000e\u0000 \u0000s\u0000a\u0000f\u0000e\u0000t\u0000y\u0000 \u0000o\u0000f\u0000 \u0000a\u0000u\u0000t\u0000o\u0000n\u0000o\u0000m\u0000o\u0000u\u0000s\u0000 \u0000s\u0000y\u0000s\u0000t\u0000e\u0000m\u0000s\u0000,\u0000 \u0000u\u0000p\u0000h\u0000o\u0000l\u0000d\u0000 \u0000f\u0000a\u0000i\u0000r\u0000n\u0000e\u0000s\u0000s\u0000 \u0000i\u0000n\u0000 \u0000f\u0000i\u0000n\u0000a\u0000n\u0000c\u0000i\u0000a\u0000l\u0000 \u0000s\u0000e\u0000r\u0000v\u0000i\u0000c\u0000e\u0000s\u0000,\u0000 \u0000s\u0000t\u0000r\u0000e\u0000n\u0000g\u0000t\u0000h\u0000e\u0000n\u0000 \u0000c\u0000y\u0000b\u0000e\u0000r\u0000s\u0000e\u0000c\u0000u\u0000r\u0000i\u0000t\u0000y\u0000,\u0000 \u0000t\u0000a\u0000c\u0000k\u0000l\u0000e\u0000 \u0000e\u0000n\u0000v\u0000i\u0000r\u0000o\u0000n\u0000m\u0000e\u0000n\u0000t\u0000a\u0000l\u0000 \u0000i\u0000s\u0000s\u0000u\u0000e\u0000s\u0000,\u0000 \u0000e\u0000t\u0000h\u0000i\u0000c\u0000a\u0000l\u0000l\u0000y\u0000 \u0000m\u0000o\u0000d\u0000e\u0000r\u0000a\u0000t\u0000e\u0000 \u0000d\u0000i\u0000g\u0000i\u0000t\u0000a\u0000l\u0000 \u0000c\u0000o\u0000n\u0000t\u0000e\u0000n\u0000t\u0000,\u0000 \u0000r\u0000e\u0000f\u0000o\u0000r\u0000m\u0000 \u0000t\u0000h\u0000e\u0000 \u0000c\u0000r\u0000i\u0000m\u0000i\u0000n\u0000a\u0000l\u0000 \u0000j\u0000u\u0000s\u0000t\u0000i\u0000c\u0000e\u0000 \u0000s\u0000y\u0000s\u0000t\u0000e\u0000m\u0000,\u0000 \u0000a\u0000n\u0000d\u0000 \u0000t\u0000a\u0000i\u0000l\u0000o\u0000r\u0000 \u0000e\u0000d\u0000u\u0000c\u0000a\u0000t\u0000i\u0000o\u0000n\u0000a\u0000l\u0000 \u0000e\u0000x\u0000p\u0000e\u0000r\u0000i\u0000e\u0000n\u0000c\u0000e\u0000s\u0000,\u0000 \u0000a\u0000l\u0000l\u0000 \u0000w\u0000h\u0000i\u0000l\u0000e\u0000 \u0000p\u0000r\u0000i\u0000o\u0000r\u0000i\u0000t\u0000i\u0000z\u0000i\u0000n\u0000g\u0000 \u0000s\u0000a\u0000f\u0000e\u0000t\u0000y\u0000,\u0000 \u0000e\u0000q\u0000u\u0000i\u0000t\u0000y\u0000,\u0000 \u0000a\u0000n\u0000d\u0000 \u0000t\u0000a\u0000n\u0000g\u0000i\u0000b\u0000l\u0000e\u0000 \u0000b\u0000e\u0000n\u0000e\u0000f\u0000i\u0000t\u0000s\u0000 \u0000f\u0000o\u0000r\u0000 \u0000s\u0000o\u0000c\u0000i\u0000e\u0000t\u0000y\u0000.\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000h\u00002\u0000>\u0000Q\u0000u\u0000o\u0000t\u0000e\u0000:\u0000<\u0000/\u0000h\u00002\u0000>\u0000\n\u0000<\u0000p\u0000>\u0000\"\u0000<\u0000e\u0000m\u0000>\u0000T\u0000h\u0000e\u0000 \u0000b\u0000a\u0000s\u0000i\u0000c\u0000 \u0000g\u0000u\u0000i\u0000d\u0000e\u0000l\u0000i\u0000n\u0000e\u0000s\u0000 \u0000o\u0000f\u0000 \u0000a\u0000n\u0000 \u0000e\u0000t\u0000h\u0000i\u0000c\u0000a\u0000l\u0000 \u0000A\u0000I\u0000 \u0000s\u0000y\u0000s\u0000t\u0000e\u0000m\u0000 \u0000r\u0000e\u0000f\u0000e\u0000r\u0000 \u0000t\u0000o\u0000 \u0000t\u0000h\u0000o\u0000s\u0000e\u0000 \u0000v\u0000a\u0000l\u0000u\u0000e\u0000s\u0000 \u0000w\u0000h\u0000i\u0000c\u0000h\u0000 \u0000c\u0000a\u0000n\u0000 \u0000b\u0000e\u0000 \u0000i\u0000m\u0000p\u0000l\u0000e\u0000m\u0000e\u0000n\u0000t\u0000e\u0000d\u0000 \u0000a\u0000t\u0000 \u0000t\u0000h\u0000e\u0000 \u0000c\u0000o\u0000r\u0000e\u0000 \u0000o\u0000f\u0000 \u0000e\u0000v\u0000e\u0000r\u0000y\u0000 \u0000A\u0000I\u0000 \u0000a\u0000l\u0000g\u0000o\u0000r\u0000i\u0000t\u0000h\u0000m\u0000 \u0000t\u0000o\u0000 \u0000b\u0000r\u0000i\u0000n\u0000g\u0000 \u0000o\u0000u\u0000t\u0000 \u0000t\u0000h\u0000e\u0000 \u0000s\u0000a\u0000f\u0000e\u0000t\u0000y\u0000,\u0000 \u0000s\u0000e\u0000c\u0000u\u0000r\u0000i\u0000t\u0000y\u0000,\u0000 \u0000a\u0000n\u0000d\u0000 \u0000f\u0000u\u0000n\u0000d\u0000a\u0000m\u0000e\u0000n\u0000t\u0000a\u0000l\u0000 \u0000g\u0000o\u0000o\u0000d\u0000n\u0000e\u0000s\u0000s\u0000 \u0000o\u0000f\u0000 \u0000a\u0000r\u0000t\u0000i\u0000f\u0000i\u0000c\u0000i\u0000a\u0000l\u0000 \u0000i\u0000n\u0000t\u0000e\u0000l\u0000l\u0000i\u0000g\u0000e\u0000n\u0000c\u0000e\u0000 \u0000f\u0000o\u0000r\u0000 \u0000a\u0000l\u0000l\u0000 \u0000b\u0000e\u0000i\u0000n\u0000g\u0000s\u0000 \u0000a\u0000n\u0000d\u0000 \u0000h\u0000u\u0000m\u0000a\u0000n\u0000 \u0000s\u0000o\u0000c\u0000i\u0000e\u0000t\u0000y\u0000 \u0000a\u0000t\u0000 \u0000l\u0000a\u0000r\u0000g\u0000e\u0000.\u0000<\u0000/\u0000e\u0000m\u0000>\u0000\"\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000p\u0000>\u0000~\u0000~\u0000~\u0000 \u0000A\u0000m\u0000i\u0000t\u0000 \u0000R\u0000a\u0000y\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000h\u00002\u0000>\u0000B\u0000a\u0000c\u0000k\u0000g\u0000r\u0000o\u0000u\u0000n\u0000d\u0000<\u0000/\u0000h\u00002\u0000>\u0000\n\u0000<\u0000p\u0000>\u0000I\u0000 \u0000j\u0000o\u0000i\u0000n\u0000e\u0000d\u0000 \u0000t\u0000h\u0000e\u0000 \u0000C\u0000o\u0000m\u0000p\u0000u\u0000t\u0000e\u0000r\u0000 \u0000S\u0000c\u0000i\u0000e\u0000n\u0000c\u0000e\u0000 \u0000D\u0000e\u0000p\u0000a\u0000r\u0000t\u0000m\u0000e\u0000n\u0000t\u0000 \u0000a\u0000t\u0000 \u0000U\u0000T\u0000 \u0000D\u0000a\u0000l\u0000l\u0000a\u0000s\u0000 \u0000a\u0000s\u0000 \u0000a\u0000n\u0000 \u0000A\u0000s\u0000s\u0000o\u0000c\u0000i\u0000a\u0000t\u0000e\u0000 \u0000P\u0000r\u0000o\u0000f\u0000e\u0000s\u0000s\u0000o\u0000r\u0000 \u0000w\u0000i\u0000t\u0000h\u0000 \u0000t\u0000e\u0000n\u0000u\u0000r\u0000e\u0000 \u0000i\u0000n\u0000 \u00002\u00000\u00001\u00009\u0000-\u0000F\u0000a\u0000l\u0000l\u0000.\u0000 \u0000I\u0000 \u0000w\u0000a\u0000s\u0000 \u0000p\u0000r\u0000e\u0000v\u0000i\u0000o\u0000u\u0000s\u0000l\u0000y\u0000 \u0000a\u0000n\u0000 \u0000a\u0000s\u0000s\u0000i\u0000s\u0000t\u0000a\u0000n\u0000t\u0000 \u0000p\u0000r\u0000o\u0000f\u0000e\u0000s\u0000s\u0000o\u0000r\u0000 \u0000i\u0000n\u0000 \u0000t\u0000h\u0000e\u0000 \u0000C\u0000o\u0000m\u0000p\u0000u\u0000t\u0000e\u0000r\u0000 \u0000S\u0000c\u0000i\u0000e\u0000n\u0000c\u0000e\u0000 \u0000d\u0000e\u0000p\u0000a\u0000r\u0000t\u0000m\u0000e\u0000n\u0000t\u0000 \u0000a\u0000t\u0000 \u0000U\u0000n\u0000i\u0000v\u0000e\u0000r\u0000s\u0000i\u0000t\u0000y\u0000 \u0000a\u0000t\u0000 \u0000A\u0000l\u0000b\u0000a\u0000n\u0000y\u0000 \u0000-\u0000 \u0000S\u0000U\u0000N\u0000Y\u0000 \u0000f\u0000r\u0000o\u0000m\u0000 \u00002\u00000\u00001\u00004\u0000-\u0000S\u0000p\u0000r\u0000i\u0000n\u0000g\u0000 \u0000t\u0000o\u0000 \u00002\u00000\u00001\u00009\u0000-\u0000S\u0000p\u0000r\u0000i\u0000n\u0000g\u0000.\u0000 \u0000 \u0000I\u0000 \u0000w\u0000a\u0000s\u0000 \u0000a\u0000 \u0000p\u0000o\u0000s\u0000t\u0000d\u0000o\u0000c\u0000t\u0000o\u0000r\u0000a\u0000l\u0000 \u0000r\u0000e\u0000s\u0000e\u0000a\u0000r\u0000c\u0000h\u0000e\u0000r\u0000 \u0000i\u0000n\u0000 \u0000t\u0000h\u0000e\u0000 \u0000E\u0000v\u0000e\u0000n\u0000t\u0000 \u0000a\u0000n\u0000d\u0000 \u0000P\u0000a\u0000t\u0000t\u0000e\u0000r\u0000n\u0000 \u0000D\u0000e\u0000t\u0000e\u0000c\u0000t\u0000i\u0000o\u0000n\u0000 \u0000(\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000s\u0000.\u0000c\u0000m\u0000u\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000n\u0000e\u0000i\u0000l\u0000l\u0000/\u0000E\u0000P\u0000D\u0000/\u0000i\u0000n\u0000d\u0000e\u0000x\u0000.\u0000h\u0000t\u0000m\u0000l\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000E\u0000P\u0000D\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000)\u0000 \u0000L\u0000a\u0000b\u0000o\u0000r\u0000a\u0000t\u0000o\u0000r\u0000y\u0000 \u0000a\u0000n\u0000d\u0000 \u0000t\u0000h\u0000e\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000i\u0000l\u0000a\u0000b\u0000.\u0000h\u0000e\u0000i\u0000n\u0000z\u0000.\u0000c\u0000m\u0000u\u0000.\u0000e\u0000d\u0000u\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000i\u0000L\u0000a\u0000b\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000a\u0000t\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000m\u0000u\u0000.\u0000e\u0000d\u0000u\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000C\u0000a\u0000r\u0000n\u0000e\u0000g\u0000i\u0000e\u0000 \u0000M\u0000e\u0000l\u0000l\u0000o\u0000n\u0000 \u0000U\u0000n\u0000i\u0000v\u0000e\u0000r\u0000s\u0000i\u0000t\u0000y\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000i\u0000n\u0000 \u00002\u00000\u00001\u00003\u0000,\u0000 \u0000w\u0000h\u0000e\u0000r\u0000e\u0000 \u0000I\u0000 \u0000w\u0000o\u0000r\u0000k\u0000e\u0000d\u0000 \u0000w\u0000i\u0000t\u0000h\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000s\u0000.\u0000c\u0000m\u0000u\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000n\u0000e\u0000i\u0000l\u0000l\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000D\u0000a\u0000n\u0000i\u0000e\u0000l\u0000 \u0000B\u0000.\u0000 \u0000N\u0000e\u0000i\u0000l\u0000l\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000a\u0000n\u0000d\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000h\u0000e\u0000i\u0000n\u0000z\u0000.\u0000c\u0000m\u0000u\u0000.\u0000e\u0000d\u0000u\u0000/\u0000f\u0000a\u0000c\u0000u\u0000l\u0000t\u0000y\u0000-\u0000a\u0000n\u0000d\u0000-\u0000r\u0000e\u0000s\u0000e\u0000a\u0000r\u0000c\u0000h\u0000/\u0000f\u0000a\u0000c\u0000u\u0000l\u0000t\u0000y\u0000-\u0000p\u0000r\u0000o\u0000f\u0000i\u0000l\u0000e\u0000s\u0000/\u0000f\u0000a\u0000c\u0000u\u0000l\u0000t\u0000y\u0000-\u0000d\u0000e\u0000t\u0000a\u0000i\u0000l\u0000s\u0000/\u0000i\u0000n\u0000d\u0000e\u0000x\u0000.\u0000a\u0000s\u0000p\u0000x\u0000?\u0000f\u0000a\u0000c\u0000u\u0000l\u0000t\u0000y\u0000_\u0000i\u0000d\u0000=\u00005\u00001\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000R\u0000a\u0000m\u0000a\u0000y\u0000y\u0000a\u0000 \u0000K\u0000r\u0000i\u0000s\u0000h\u0000n\u0000a\u0000n\u0000 \u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000.\u0000 \u0000I\u0000 \u0000g\u0000o\u0000t\u0000 \u0000m\u0000y\u0000 \u0000P\u0000h\u0000.\u0000D\u0000.\u0000 \u0000f\u0000r\u0000o\u0000m\u0000 \u0000t\u0000h\u0000e\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000s\u0000.\u0000v\u0000t\u0000.\u0000e\u0000d\u0000u\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000C\u0000o\u0000m\u0000p\u0000u\u0000t\u0000e\u0000r\u0000 \u0000S\u0000c\u0000i\u0000e\u0000n\u0000c\u0000e\u0000 \u0000D\u0000e\u0000p\u0000a\u0000t\u0000m\u0000e\u0000n\u0000t\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000a\u0000t\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000v\u0000t\u0000.\u0000e\u0000d\u0000u\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000V\u0000i\u0000r\u0000g\u0000i\u0000n\u0000i\u0000a\u0000 \u0000P\u0000o\u0000l\u0000y\u0000t\u0000e\u0000c\u0000h\u0000n\u0000i\u0000c\u0000 \u0000I\u0000n\u0000s\u0000t\u0000i\u0000t\u0000u\u0000t\u0000e\u0000 \u0000a\u0000n\u0000d\u0000 \u0000S\u0000t\u0000a\u0000t\u0000e\u0000 \u0000U\u0000n\u0000i\u0000v\u0000e\u0000r\u0000s\u0000i\u0000t\u0000y\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000u\u0000n\u0000d\u0000e\u0000r\u0000 \u0000t\u0000h\u0000e\u0000 \u0000a\u0000d\u0000v\u0000i\u0000s\u0000i\u0000n\u0000g\u0000 \u0000o\u0000f\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000n\u0000v\u0000c\u0000.\u0000c\u0000s\u0000.\u0000v\u0000t\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000c\u0000t\u0000l\u0000u\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000C\u0000h\u0000a\u0000n\u0000g\u0000-\u0000T\u0000i\u0000e\u0000n\u0000 \u0000L\u0000u\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000i\u0000n\u0000 \u0000D\u0000e\u0000c\u0000.\u0000 \u00002\u00000\u00001\u00002\u0000;\u0000 \u0000M\u0000.\u0000S\u0000.\u0000 \u0000f\u0000r\u0000o\u0000m\u0000 \u0000t\u0000h\u0000e\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000s\u0000c\u0000s\u0000e\u0000.\u0000b\u0000u\u0000a\u0000a\u0000.\u0000e\u0000d\u0000u\u0000.\u0000c\u0000n\u0000/\u0000W\u0000e\u0000b\u0000x\u0000x\u0000/\u0000C\u0000m\u0000s\u0000_\u0000q\u0000t\u0000/\u0000i\u0000n\u0000d\u0000e\u0000x\u0000.\u0000j\u0000s\u0000p\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000S\u0000c\u0000h\u0000o\u0000o\u0000l\u0000 \u0000o\u0000f\u0000 \u0000C\u0000o\u0000m\u0000p\u0000u\u0000t\u0000e\u0000r\u0000 \u0000S\u0000c\u0000i\u0000e\u0000n\u0000c\u0000e\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000a\u0000t\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000b\u0000e\u0000i\u0000h\u0000a\u0000n\u0000g\u0000.\u0000e\u0000d\u0000u\u0000.\u0000c\u0000n\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000B\u0000e\u0000i\u0000j\u0000i\u0000n\u0000g\u0000 \u0000U\u0000n\u0000i\u0000v\u0000e\u0000r\u0000s\u0000i\u0000t\u0000y\u0000 \u0000o\u0000f\u0000 \u0000A\u0000e\u0000r\u0000o\u0000n\u0000a\u0000u\u0000t\u0000i\u0000c\u0000s\u0000 \u0000&\u0000a\u0000m\u0000p\u0000;\u0000 \u0000A\u0000s\u0000t\u0000r\u0000o\u0000n\u0000a\u0000u\u0000t\u0000i\u0000c\u0000s\u0000 \u0000U\u0000n\u0000i\u0000v\u0000e\u0000r\u0000s\u0000i\u0000t\u0000y\u0000 \u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000i\u0000n\u0000 \u0000M\u0000a\u0000r\u0000.\u0000 \u00002\u00000\u00000\u00004\u0000;\u0000 \u0000a\u0000n\u0000d\u0000 \u0000B\u0000.\u0000S\u0000.\u0000 \u0000f\u0000r\u0000o\u0000m\u0000 \u0000t\u0000h\u0000e\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000c\u0000c\u0000c\u0000.\u0000h\u0000n\u0000u\u0000.\u0000c\u0000n\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000S\u0000c\u0000h\u0000o\u0000o\u0000l\u0000 \u0000o\u0000f\u0000 \u0000C\u0000o\u0000m\u0000p\u0000u\u0000t\u0000e\u0000r\u0000 \u0000a\u0000n\u0000d\u0000 \u0000C\u0000o\u0000m\u0000m\u0000u\u0000n\u0000i\u0000c\u0000a\u0000t\u0000i\u0000o\u0000n\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000a\u0000t\u0000 \u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000h\u0000n\u0000u\u0000.\u0000e\u0000d\u0000u\u0000.\u0000c\u0000n\u0000/\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000H\u0000u\u0000n\u0000a\u0000n\u0000 \u0000U\u0000n\u0000i\u0000v\u0000e\u0000r\u0000s\u0000i\u0000t\u0000y\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000 \u0000i\u0000n\u0000 \u0000J\u0000u\u0000l\u0000.\u0000 \u00002\u00000\u00000\u00001\u0000.\u0000 \u0000D\u0000u\u0000r\u0000i\u0000n\u0000g\u0000 \u0000m\u0000y\u0000 \u0000d\u0000o\u0000c\u0000t\u0000o\u0000r\u0000a\u0000l\u0000 \u0000s\u0000t\u0000u\u0000d\u0000i\u0000e\u0000s\u0000,\u0000 \u0000I\u0000 \u0000a\u0000l\u0000s\u0000o\u0000 \u0000w\u0000o\u0000r\u0000k\u0000e\u0000d\u0000 \u0000a\u0000t\u0000 \u0000I\u0000B\u0000M\u0000 \u0000T\u0000.\u0000J\u0000.\u0000 \u0000W\u0000a\u0000t\u0000s\u0000o\u0000n\u0000 \u0000R\u0000e\u0000s\u0000e\u0000a\u0000r\u0000c\u0000h\u0000 \u0000L\u0000a\u0000b\u0000s\u0000,\u0000 \u0000H\u0000a\u0000w\u0000t\u0000h\u0000o\u0000r\u0000n\u0000e\u0000,\u0000 \u0000N\u0000Y\u0000 \u0000d\u0000u\u0000r\u0000i\u0000n\u0000g\u0000 \u00002\u00000\u00001\u00001\u0000 \u0000s\u0000u\u0000m\u0000m\u0000e\u0000r\u0000.\u0000 \u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000h\u00002\u0000>\u0000T\u0000e\u0000a\u0000c\u0000h\u0000i\u0000n\u0000g\u0000<\u0000/\u0000h\u00002\u0000>\u0000\n\u0000<\u0000p\u0000>\u00002\u00000\u00001\u00009\u0000 \u0000S\u0000p\u0000r\u0000i\u0000n\u0000g\u0000,\u0000 \u0000I\u0000C\u0000S\u0000I\u00004\u00003\u00001\u0000/\u0000I\u0000C\u0000S\u0000I\u00005\u00003\u00001\u0000 \u0000D\u0000a\u0000t\u0000a\u0000 \u0000M\u0000i\u0000n\u0000i\u0000n\u0000g\u0000 \u0000[\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000s\u0000.\u0000a\u0000l\u0000b\u0000a\u0000n\u0000y\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000f\u0000c\u0000h\u0000e\u0000n\u0000/\u0000c\u0000o\u0000u\u0000r\u0000s\u0000e\u0000/\u00002\u00000\u00001\u00008\u0000-\u0000I\u0000C\u0000S\u0000I\u0000-\u00004\u00003\u00001\u0000-\u00005\u00003\u00001\u0000/\u0000i\u0000n\u0000d\u0000e\u0000x\u0000.\u0000h\u0000t\u0000m\u0000l\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000L\u0000i\u0000n\u0000k\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000]\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000p\u0000>\u00002\u00000\u00001\u00008\u0000 \u0000F\u0000a\u0000l\u0000l\u0000,\u0000 \u0000I\u0000C\u0000S\u0000I\u00006\u00006\u00000\u0000 \u0000A\u0000n\u0000o\u0000m\u0000a\u0000l\u0000o\u0000u\u0000s\u0000 \u0000P\u0000a\u0000t\u0000t\u0000e\u0000r\u0000n\u0000 \u0000D\u0000e\u0000t\u0000e\u0000c\u0000t\u0000i\u0000o\u0000n\u0000 \u0000[\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000s\u0000.\u0000a\u0000l\u0000b\u0000a\u0000n\u0000y\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000f\u0000c\u0000h\u0000e\u0000n\u0000/\u0000c\u0000o\u0000u\u0000r\u0000s\u0000e\u0000/\u00002\u00000\u00001\u00008\u0000-\u0000I\u0000C\u0000S\u0000I\u0000-\u00006\u00006\u00000\u0000/\u0000i\u0000n\u0000d\u0000e\u0000x\u0000.\u0000h\u0000t\u0000m\u0000l\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000L\u0000i\u0000n\u0000k\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000]\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000p\u0000>\u00002\u00000\u00001\u00008\u0000 \u0000S\u0000p\u0000r\u0000i\u0000n\u0000g\u0000,\u0000 \u0000I\u0000C\u0000S\u0000I\u00004\u00003\u00001\u0000/\u0000I\u0000C\u0000S\u0000I\u00005\u00003\u00001\u0000 \u0000D\u0000a\u0000t\u0000a\u0000 \u0000M\u0000i\u0000n\u0000i\u0000n\u0000g\u0000 \u0000[\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000s\u0000.\u0000a\u0000l\u0000b\u0000a\u0000n\u0000y\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000f\u0000c\u0000h\u0000e\u0000n\u0000/\u0000c\u0000o\u0000u\u0000r\u0000s\u0000e\u0000/\u00002\u00000\u00001\u00008\u0000-\u0000I\u0000C\u0000S\u0000I\u0000-\u00004\u00003\u00001\u0000-\u00005\u00003\u00001\u0000/\u0000i\u0000n\u0000d\u0000e\u0000x\u0000.\u0000h\u0000t\u0000m\u0000l\u0000\"\u0000>\u0000<\u0000s\u0000p\u0000a\u0000n\u0000 \u0000c\u0000l\u0000a\u0000s\u0000s\u0000=\u0000\"\u0000s\u00002\u0000\"\u0000>\u0000L\u0000i\u0000n\u0000k\u0000<\u0000/\u0000s\u0000p\u0000a\u0000n\u0000>\u0000<\u0000/\u0000a\u0000>\u0000]\u0000<\u0000/\u0000p\u0000>\u0000\n\u0000<\u0000p\u0000>\u00002\u00000\u00001\u00007\u0000 \u0000S\u0000p\u0000r\u0000i\u0000n\u0000g\u0000,\u0000 \u0000I\u0000C\u0000S\u0000I\u00004\u00003\u00001\u0000/\u0000I\u0000C\u0000S\u0000I\u00005\u00003\u00001\u0000 \u0000D\u0000a\u0000t\u0000a\u0000 \u0000M\u0000i\u0000n\u0000i\u0000n\u0000g\u0000 \u0000[\u0000<\u0000a\u0000 \u0000h\u0000r\u0000e\u0000f\u0000=\u0000\"\u0000h\u0000t\u0000t\u0000p\u0000:\u0000/\u0000/\u0000w\u0000w\u0000w\u0000.\u0000c\u0000s\u0000.\u0000a\u0000l\u0000b\u0000a\u0000n\u0000y\u0000.\u0000e\u0000d\u0000u\u0000/\u0000~\u0000f\u0000c\u0000h\u0000e\u0000n\u0000/\u0000c\u0000o\u0000u\u0000r\u