      \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Yang Yu,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  and Jun Wang.\nIn Advances in Neural Information Processing Systems 37\n. \n      \n      \n        2024.\nICML\nDeep Demonstration Tracing: Learning Generalizable Imitator Policy for Runtime Imitation from a Single Demonstration\n[\nLink\nCode\nWebsite\n]\nXiong-Hui Chen\n,\n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Junyin Ye,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Hang Zhao,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Yi-Chen Li,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Xu-Hui Liu,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Haoran Shi,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Yu-Yan Xu,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Zhihao Ye,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Si-Hang Yang,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Anqi Huang,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Kai Xu,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Zongzhang Zhang,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  and Yang Yu.\nIn The 41st International Conference on Machine Learning\n. \n      \n      \n        2024.\nNeurIPS\nAdversarial Counterfactual Environment Model Learning\n(Spotlight)\n[\nLink\nCode\n]\nXiong-Hui Chen\n,\n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Yang Yu,\n                \n              \n            \n          \n        \n          \n          \n          \n          \n          \n          \n            \n              \n                \n                  Zheng-Mao Zhu,\n                \n              \n            \n          \n        \n  