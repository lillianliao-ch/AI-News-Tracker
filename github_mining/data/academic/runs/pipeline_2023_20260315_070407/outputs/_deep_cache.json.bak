  "deep_homepage::Xin Zheng::https://casey68z.github.io/Xin-ZHENG-CV/about.html": {
    "homepage": "https://casey68z.github.io/Xin-ZHENG-CV/about.html",
    "all_emails": [
      "xinzheng.agecon@gmail.com"
    ],
    "matched_email": null,
    "github": "https://github.com/Casey68Z",
    "linkedin": "https://www.linkedin.com/in/xin-zheng-b6865919a/",
    "homepage_text": "Xin Zheng's Personal Website\nXin Zheng's Personal Website\nWelcome to my academic and industrial portfolio\nAbout Me\nWelcome! I’m Xin Zheng, a 24-year-old early-stage researcher who recently completed my M.S. in Economics at the University of Wisconsin–Madison.\nI am the first year Ph.D. student in Agricultural, Environmental, and Development Economics(AEDE) at The Ohio State University.\nMy academic passion lies in applying economic theory and machine learning methods to tackle real-world challenges in agriculture, environment, and development.\nAs a problem-solver, I thrive in coordinating complex projects and mobilizing resources efficiently.\nMy current research interests include natural resource markets, energy policy analysis, industrial organization, and the integration of machine learning into economic modeling.\nBeyond academia, I’m a passionate amateur pianist and composer, always exploring new ways to express creativity through music.\nMy Github:\nhttps://github.com/Casey68Z\nMy LinkedIn:\nhttps://www.linkedin.com/in/xin-zheng-b6865919a/\n📄 View My CV\nEducation\nFirst Year Ph.D. Student in Agricultural, Environmental, and Development Economics, The Ohio State University 2025-\nM.S. in Economics, University of Wisconsin-Madison, 2023-2025\nB.S. in Economics, University of Liverpool, 2019-2023\nContact\nIf you would like to get in touch with me, please reach out via email.\nEmail:\nxinzheng.agecon@gmail.com"
  },
  "deep_homepage::Shirui Pan::https://shiruipan.github.io/": {
    "homepage": "https://shiruipan.github.io/",
