  "deep_homepage::Zhihong Shao::https://zhihongshao.github.io/": {
    "homepage": "https://zhihongshao.github.io/",
    "all_emails": [
      "zhshaothu@gmail.com"
    ],
    "matched_email": null,
    "github": "https://github.com/ZhihongShao",
