    "homepage_text": "ZHANG Beichen\n{{$t(\"basicTitle\")}}\n{{$t(\"nameTitle\")}}:\n{{$t(\"nav.name\")}}\n{{$t(\"genderTitle\")}}:\n{{$t(\"gender\")}}\n{{$t(\"birthTitle\")}}:\n{{$t(\"birth\")}}\n{{$t(\"countryTitle\")}}:\n{{$t(\"country\")}}\n{{$t(\"hometownTitle\")}}:\n{{$t(\"hometown\")}}\n{{$t(\"emailTitle\")}}:\n{{$t(\"email\")}}\n{{$t(\"address\")}}\n{{$t(\"linkTitles\")}}:\n{{$t(\"linkName1\")}}\n,\n{{$t(\"linkName2\")}}\n,\n{{$t(\"linkName3\")}}\n,\n{{$t(\"linkName4\")}}\n,\n{{$t(\"linkName5\")}}\n{{$t(\"employmentTitle\")}}\n{{$t(\"employmentTimeRange3\")}}:\n{{$t(\"employmentWork3\")}}\n{{$t(\"employmentTimeRange2\")}}:\n{{$t(\"employmentWork2\")}}\n{{$t(\"employmentTimeRange1\")}}:\n{{$t(\"employmentWork1\")}}\n{{$t(\"studyTitle\")}}\n{{$t(\"studyPeriod2\")}}:\n{{$t(\"studyPeriod2Time\")}}\n{{$t(\"univTitle\")}}:\n{{$t(\"CUName\")}}\n{{$t(\"CUDes\")}}\n{{$t(\"schTitle\")}}:\n{{$t(\"CUSchName\")}}\n{{$t(\"majorTitle\")}}:\n{{$t(\"major2Name\")}}\n{{$t(\"labTitle\")}}:\n{{$t(\"lab2Name\")}}\n,\n{{$t(\"CReSName\")}}\n{{$t(\"fieldTitle\")}}:\n{{$t(\"field2Des\")}}\n{{$t(\"studyPeriod1\")}}:\n{{$t(\"studyPeriod1Time\")}}\n{{$t(\"univTitle\")}}:\n{{$t(\"NNUName\")}}\n{{$t(\"NNUDes\")}}\n{{$t(\"schTitle\")}}:\n{{$t(\"NNUSchName\")}}\n{{$t(\"majorTitle\")}}:\n{{$t(\"major1Name\")}}\n{{$t(\"major1Des\")}}\n{{$t(\"labTitle\")}}:\n{{$t(\"labName\")}}\n,\n{{$t(\"vgeName\")}}\n{{$t(\"fieldTitle\")}}:\n{{$t(\"fieldDes\")}}\n{{$t(\"studyPeriod0\")}}:\n{{$t(\"studyPeriod0Time\")}}\n{{$t(\"univTitle\")}}:\n{{$t(\"NuistName\")}}\n{{$t(\"NuistDes\")}}\n{{$t(\"schTitle\")}}:\n{{$t(\"NuistSchName\")}}\n{{$t(\"majorTitle\")}}:\n{{$t(\"major0Name\")}}\n{{$t(\"courseTitle\")}}:\n{{$t(\"courseDes\")}}\n{{$t(\"technologyTitle\")}}\n{{graspItem[0]}}:\n{{graspItem[1]}}\n{{$t(\"hobbyTitle\")}}\n{{$t(\"hobbiesDes\")}}"
