  "deep_homepage::Ran He::https://rhe-web.github.io/": {
    "homepage": "https://rhe-web.github.io/",
    "all_emails": [
      "rhe@nlpr.ia.ac.cn"
    ],
    "matched_email": null,
    "github": null,
