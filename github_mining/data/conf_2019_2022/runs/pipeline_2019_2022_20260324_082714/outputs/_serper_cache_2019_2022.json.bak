    "homepage_text": "Tai-Xiang Jiang | SWUFE\nTai-Xiang Jiang\n蒋太翔\nProfessor\nComplex Laboratory of New Finance and Economics (NICE-Lab)\nSchool of Computing and Artificial Intelligence,\nSouthwestern University of Finance and Economics (SWUFE)\ntaixiangjiang [AT] gmail [DOT] com\n|\njiangtx [AT] swufe [DOT] edu [DOT] cn\nRoom 422, Tongbo Building, SWUFE (Liulin Campus), Chengdu, China\nPostdoc Wanted:\nGuanghua Postdoc 光华博士后招聘\nExperiences\nI am currently a Professor in the School of Computing and Artificial Intelligence at\nSWUFE\n.\n2019\n: Ph.D. in Mathematics from\nUESTC\n, advised by\nProf. Ting-Zhu Huang\n.\n2019\n: Research Assistant at\nHong Kong Baptist University\n, advised by\nProf. Michael Ng\n.\n2017 - 2018\n: Visiting Student at Instituto Superior Técnico, advised by\nProf. Jose M. Bioucas Dias\n.\nResearch Interests\nImage Processing\nComputer Vision\nMachine Learning\nTensor Methods\nHyperspectral Imaging\nPublications\nBook Chapter\nTransform-based tensor singular value decomposition in multidimensional image recovery\nTai-Xiang Jiang\n, Michael K Ng, Xi-Le Zhao\nin Tensors for Data Processing: Theory, Methods and Applications, Elsevier, 2022.\nPDF\nBibTeX\n@incollection{jiang2022transform,\n  title={Transform-based tensor singular value decomposition in multidimensional image recovery},\n  author={Jiang, Tai-Xiang and Ng, Michael K and Zhao, Xi-Le},\n  booktitle={Tensors for Data Processing},\n  pages={31--60},\n  year={2022},\n  publisher={Elsevier}\n}\nCopy\nOnline\nDELTA: Deep Low-Rank Tensor Representation for Multi-Dimensional Data Recovery\nGuo-Wei Yang, Liqiao Yang,\nTai-Xiang Jiang*\n, Guisong Liu, Michael K Ng\nIEEE Transactions on Pattern Analysis and Machine Intelligence\nPDF\nPyTorch Demo\nBibTeX\n@article{yang2025delta,\n  title={DELTA: Deep Low-Rank Tensor Representation for Multi-Dimensional Data Recovery},\n  author={Yang, Guo-Wei and Yang, Liqiao and Jiang, Tai-Xiang and Liu, Guisong and Ng, Michael K},\n  journal={IEEE transactions on pattern analysis and machine intelligence},\n  doi={10.1109/TPAMI.2025.3630339},\n  year={2025}\n}\nCopy\n2026\nDegradation accordant plug-and-play for low-rank tensor recovery\nYexun Hu, Zixin Tang,\nTai-Xiang Jiang*\n, Xi-Le Zhao, Guisong Liu\nPattern Recognition, 2026.\nPDF\nPyTorch Demo\nBibTeX\n@article{HU2026112612,\ntitle={Degradation accordant plug-and-play for low-rank tensor recovery},\nauthor={Yexun Hu and Zixin Tang and Tai-Xiang Jiang and Xi-Le Zhao and Guisong Liu},\njournal={Pattern Recognition},\nvolume={172},\npages={112612},\nyear={2026}\n}\nCopy\n2025\nPALADIN: a novel plug-and-play 3D CS-MRI reconstruction method\nJia-Mian Wu, Shi-Bai Yin,\nTai-Xiang Jiang*\n, Gui-Song Liu, Xi-Le Zhao\nInverse Problems, 2025.\nPDF\nPyTorch Demo\nBibTeX\n@article{wu2025paladin,\n  title={PALADIN: a novel plug-and-play 3D CS-MRI reconstruction method},\n  author={Wu, Jia-Mian and Yin, Shi-Bai and Jiang, Tai-Xiang and Liu, Gui-Song and Zhao, Xi-Le},\n  journal={Inverse Problems},\n  volume={41},\n  number={3},\n  pages={035014},\n  year={2025},\n  publisher={IOP Publishing}\n}\nCopy\nEnhancing the Adversarial Robustness via Manifold Projection\nZhiting Li, Shibai Yin,\nTai-Xiang Jiang*\n, Yexun Hu, Jia-Mian Wu, Guowei Yang, Guisong Liu\nAAAI, 2025.\nPDF\nPyTorch Demo\nBibTeX\n@inproceedings{li2025enhancing,\n  title={Enhancing the Adversarial Robustness via Manifold Projection},\n  author={Li, Zhiting and Yin, Shibai and Jiang, Tai-Xiang and Hu, Yexun and Wu, Jia-Mian and Yang, Guowei and Liu, Guisong},\n  booktitle={Proceedings of the AAAI Conference on Artificial Intelligence},\n  volume={39},\n  number={1},\n  pages={451--459},\n  year={2025}\n}\nCopy\nAdaptive sampling with tensor leverage scores for exact low-rank third-order tensor completion\nXuan Chen,\nTai-Xiang Jiang*\n, Yexun Hu, Jinjin Yu, Michael K Ng\nApplied Mathematical Modelling, 2025.\nPDF\nBibTeX\n@article{chen2025adaptive,\n  title={Adaptive sampling with tensor leverage scores for exact low-rank third-order tensor completion},\n  author={Chen, Xuan and Jiang, Tai-Xiang and Hu, Yexun and Yu, Jinjin and Ng, Michael K},\n  journal={Applied Mathematical Modelling},\n  volume={138},\n  pages={115744},\n  year={2025},\n  publisher={Elsevier}\n}\nCopy\nLearning a more compact representation for low-rank tensor completion\nXi-Zhuo Li, Liqiao Yang,\nTai-Xiang Jiang*\n,  Guisong Liu\nNeurocomputing, 2025.\nPDF\nBibTeX\n@article{li2025learning,\n  title={Learning a more compact representation for low-rank tensor completion},\n  author={Li, Xi-Zhuo and Jiang, Tai-Xiang and Yang, Liqiao and Liu, Guisong},\n  journal={Neurocomputing},\n  volume={617},\n  pages={129036},\n  year={2025},\n  publisher={Elsevier}\n}\nCopy\nFourier single-pixel spectral imaging via local low-rank tensor nuclear norm and deep tensor priors\nZixin Tang, Yexun Hu, Chen Duo, Guowei Yang,\nTaixiang Jiang*\n, Daqing Guo*\nOptics Letters, 2025.\nPDF\nBibTeX\n@article{tang2025fourier,\n  title={Fourier single-pixel spectral imaging via local low-rank tensor nuclear norm and deep tensor priors},\n  author={Tang, Zixin and Hu, Yexun and Duo, Chen and Yang, Guowei and Jiang, Taixiang and Guo, Daqing},\n  journal={Optics Letters},\n  volume={50},\n  number={4},\n  pages={1281--1284},\n  year={2025},\n  publisher={Optica Publishing Group}\n}\nCopy\nSpectral Low-Rank Attention with Flow-Based Refinement for Spectral Reconstruction\nYiwen Wang, Zixin Tang, Yexun Hu*, Guisong Liu,\nTai-Xiang Jiang\nICASSP, 2025.\nPDF\nBibTeX\n@inproceedings{wang2025spectral,\n  title={Spectral Low-Rank Attention with Flow-Based Refinement for Spectral Reconstruction},\n  author={Wang, Yiwen and Tang, Zixin and Hu, Yexun and Liu, Guisong and Jiang, Tai-Xiang},\n  booktitle={ICASSP 2025-2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},\n  pages={1--5},\n  year={2025},\n  organization={IEEE}\n}\nCopy\nModel-Guided Stock Movements Prediction with Homogeneous–Heterogeneous pattern learning\nYi Zhou,\nTai-Xiang Jiang\n, Jun Wang*, Jinghua Tan*\nApplied Soft Computing, 2025.\nPDF\nBibTeX\n@article{zhou2025model,\n  title={Model-Guided Stock Movements Prediction with Homogeneous--Heterogeneous pattern learning},\n  author={Zhou, Yi and Jiang, Tai-Xiang and Wang, Jun and Tan, Jinghua},\n  journal={Applied Soft Computing},\n  volume={182},\n  pages={113519},\n  year={2025},\n  publisher={Elsevier}\n}\nCopy\nEfficient FCTN Decomposition with Structural Sparsity for Noisy Tensor Completion\nWei-Jian Huang, Li Huang,\nTai-Xiang Jiang*\n, Yu-Bang Zheng*, Guisong Liu\nIEEE Transactions on Big Data, 2025.\nPDF\nBibTeX\n@article{huang2025efficient,\n  author={Huang, Wei-Jian and Huang, Li and Jiang, Tai-Xiang and Zheng, Yu-Bang and Liu, Guisong},\n  journal={IEEE Transactions on Big Data},\n  title={Efficient FCTN Decomposition With Structural Sparsity for Noisy Tensor Completion},\n  year={2025},\n  volume={11},\n  number={6},\n  pages={3225-3239}\n}\nCopy\n2024\nCoNoT: Coupled nonlinear transform-based low-rank tensor representation for multidimensional image completion\nJian-Li Wang, Ting-Zhu Huang, Xi-Le Zhao, Yi-Si Luo,\nTai-Xiang Jiang\nIEEE Transactions on Neural Networks and Learning Systems, 2024.\nPDF\nBibTeX\n@article{wang2024conot,\n  title={CoNoT: Coupled nonlinear transform-based low-rank tensor representation for multidimensional image completion},\n  author={Wang, Jian-Li and Huang, Ting-Zhu and Zhao, Xi-Le and Luo, Yi-Si and Jiang, Tai-Xiang},\n  journal={IEEE Transactions on Neural Networks and Learning Systems},\n  volume={35},\n  number={7},\n  pages={8969--8983},\n  year={2024},\n  publisher={IEEE}\n}\nCopy\nLearnable Transform-Assisted Tensor Decomposition for Spatio-Irregular Multidimensional Data Recovery\nHao Zhang, Ting-Zhu Huang, Xi-Le Zhao, Shuqin Zhang, Jin-Yu Xie,\nTai-Xiang Jiang\n, Michael K Ng\nACM Transactions on Knowledge Discovery from Data, 2024.\nPDF\nBibTeX\n@article{zhang2024learnable,\n  title={Learnable Transform-